  "pages": {
    "backHome": "Retour à l’accueil",
    "updated": "Dernière mise à jour : {{date}}",
    "toComplete": "(à compléter)",
    "contactEmail": "Écrire un e-mail",
    "contactWhatsapp": "Écrire sur WhatsApp",
    "about": {
      "title": "À propos d’AfroPonte",
      "intro": "AfroPonte est un pont entre l’Afrique et le Brésil : un annuaire qui aide à trouver, près de chez soi, les restaurants, boutiques, salons de coiffure et ateliers de couture africains.",
      "sections": [
        {
          "h": "Notre mission",
          "p": "Rendre visibles les commerces africains et afro-descendants du Brésil, et faciliter la rencontre entre ceux qui les tiennent et ceux qui les cherchent : touristes, étudiants, migrants, hommes d’affaires, familles."
        },
        {
          "h": "Ce que vous pouvez faire",
          "p": "Chercher un commerce par ville, catégorie ou pays d’origine, le voir sur la carte, enregistrer vos favoris, laisser un avis, et écrire directement à un commerçant depuis l’application, sans passer par WhatsApp."
        },
        {
          "h": "Pour les commerçants",
          "p": "Présenter son activité est gratuit. Chaque fiche est vérifiée avant sa publication, et les avis et photos sont modérés pour garder un annuaire fiable."
        },
        {
          "h": "Une communauté",
          "p": "AfroPonte grandit avec ses utilisateurs : proposez un commerce qui manque, signalez une information fausse, partagez votre expérience."
        },
        {
          "h": "Trois langues",
          "p": "Le site est disponible en français, en anglais et en portugais."
        }
      ]
    },
    "contact": {
      "title": "Nous contacter",
      "intro": "Une question, une suggestion, un commerce à ajouter ou un problème à signaler ? Écrivez-nous.",
      "sections": [
        {
          "h": "Pour les utilisateurs",
          "p": "Pour contacter un commerçant, utilisez la messagerie de l’application depuis sa fiche."
        },
        {
          "h": "Pour les commerçants",
          "p": "Pour inscrire ou revendiquer votre activité, créez un compte commerçant. Besoin d’aide ? Écrivez-nous."
        },
        {
          "h": "Signaler un problème",
          "p": "Une fiche incorrecte ou un contenu inapproprié ? Utilisez le bouton de signalement, ou écrivez-nous en indiquant la page concernée."
        }
      ]
    },
    "privacy": {
      "title": "Politique de confidentialité",
      "intro": "Cette page explique quelles données AfroPonte collecte, pourquoi, et quels sont vos droits, conformément à la loi brésilienne de protection des données (LGPD, loi n° 13.709/2018).",
      "sections": [
        {
          "h": "Données que nous collectons",
          "p": "Compte : nom, adresse e-mail, mot de passe (chiffré), téléphone (facultatif), langue et type de compte. Utilisation : favoris, avis, photos et messages échangés dans l’application. Position : uniquement si vous utilisez « Près de moi », pour calculer les commerces proches."
        },
        {
          "h": "Pourquoi nous les utilisons",
          "p": "Pour créer et sécuriser votre compte, afficher l’annuaire, permettre la messagerie, modérer les contenus et améliorer le service. Nous ne vendons pas vos données."
        },
        {
          "h": "Vos messages",
          "p": "Les conversations sont privées. Seules les conversations signalées peuvent être consultées par l’équipe de modération, pour traiter le signalement."
        },
        {
          "h": "Partage des données",
          "p": "Vos données ne sont partagées qu’avec les prestataires techniques nécessaires au fonctionnement du site (hébergement, envoi d’e-mails), ou si la loi l’exige. Les avis et photos que vous publiez sont visibles par les autres visiteurs."
        },
        {
          "h": "Stockage sur votre appareil",
          "p": "Le site enregistre dans votre navigateur votre langue et votre session de connexion. À ce jour, il n’utilise pas de cookies publicitaires."
        },
        {
          "h": "Durée de conservation",
          "p": "Vos données sont conservées tant que votre compte est actif. Vous pouvez demander la suppression de votre compte et de vos données à tout moment."
        },
        {
          "h": "Vos droits",
          "p": "Vous pouvez demander l’accès, la correction, l’export ou la suppression de vos données, et retirer votre consentement. Écrivez à {{email}}."
        }
      ]
    },
    "terms": {
      "title": "Conditions d’utilisation",
      "intro": "En utilisant AfroPonte, vous acceptez les règles ci-dessous.",
      "sections": [
        {
          "h": "Le service",
          "p": "AfroPonte est un annuaire gratuit de commerces africains au Brésil, avec une messagerie intégrée. Nous ne vendons aucun produit ni service nous-mêmes."
        },
        {
          "h": "Votre compte",
          "p": "Vous êtes responsable de votre compte et de la confidentialité de votre mot de passe. Donnez des informations exactes. Un compte peut être suspendu en cas d’abus."
        },
        {
          "h": "Fiches des commerçants",
          "p": "Les commerçants sont responsables de l’exactitude de leurs informations (adresse, horaires, tarifs). Chaque fiche est validée par l’équipe avant publication, et peut être refusée ou retirée si elle est fausse ou trompeuse."
        },
        {
          "h": "Avis, photos et messages",
          "p": "Publiez uniquement des contenus honnêtes, qui vous appartiennent et respectent les autres. Sont interdits : insultes, harcèlement, discrimination, contenus illégaux, faux avis et spam. Les contenus peuvent être modérés ou supprimés."
        },
        {
          "h": "Signalements",
          "p": "Vous pouvez signaler une fiche, un avis, une photo ou un message. L’équipe les examine et peut suspendre les comptes concernés."
        },
        {
          "h": "Responsabilité",
          "p": "Les informations des fiches viennent des commerçants et des utilisateurs : nous ne pouvons pas garantir qu’elles soient toujours exactes. Les échanges et achats entre utilisateurs et commerçants se font sous leur seule responsabilité."
        },
        {
          "h": "Modifications",
          "p": "Nous pouvons modifier ces conditions. La date de mise à jour figure en bas de page."
        }
      ]
    },
    "legal": {
      "title": "Mentions légales",
      "intro": "Informations sur l’éditeur du site AfroPonte.",
      "sections": [
        {
          "h": "Éditeur",
          "p": "Le site est édité par {{owner}}. Contact : {{email}}."
        },
        {
          "h": "Hébergement",
          "p": "Le site est hébergé par un prestataire d’hébergement web ; ses coordonnées sont communiquées sur demande à {{email}}."
        },
        {
          "h": "Propriété intellectuelle",
          "p": "La marque AfroPonte, le logo, la conception du site et ses textes sont protégés. Les photos et textes publiés par les utilisateurs et les commerçants restent leur propriété ; en les publiant, ils autorisent AfroPonte à les afficher sur le site."
        },
